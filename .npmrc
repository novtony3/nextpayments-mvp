auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true

# Network resilience for `pnpm install` — the Docker deploy host has a slow,
# flaky link to registry.npmjs.org and timed out the CI build on the default
# 60s per-request limit (next/swc/web3icons tarballs aborted). Give large
# tarballs more time and retry harder. Applies everywhere (Docker COPYs .npmrc).
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
