# Merchant app environment — copy to `.env.local` and adjust per machine.
# `.env.local` is git-ignored; this example IS committed. Restart `pnpm dev`
# after changing env (Next reads it at startup).

# Backend origin the Next `/api/*` rewrite + Server Actions forward to. The
# browser never sees this in API calls — they stay same-origin (`/api/...`),
# so there is no CORS. Resolution precedence (see src/constants/api.ts):
#   API_PROXY_TARGET  →  NEXT_PUBLIC_API_URL  →  http://localhost:3000
#
# NEXT_PUBLIC_API_URL — the hosted backend; the default target for every env.
NEXT_PUBLIC_API_URL=https://api.vnpayment.xyz

# NEXT_PUBLIC_INTEGRATION_API_URL — public API base URL shown to merchants in
# the integration completed view (display/copy only, never fetched by the FE).
# Inlined at build time; defaults to https://api.omnipayx.io when unset (see
# src/constants/integrations.ts).
NEXT_PUBLIC_INTEGRATION_API_URL=https://api.omnipayx.io

# API_PROXY_TARGET — per-machine override. Set this for local dev to reach the
# backend through the SSH tunnel (see ../../SSH-README.md):
#   ./SSH-README.md --host <ip> --user <user> --identity <key> \
#       --remote-port 3000 --local-port 13000 --bg
# Then point it at the tunnel's local port (omit if you tunnel to :3000). Leave
# it unset to use NEXT_PUBLIC_API_URL above.
# API_PROXY_TARGET=http://localhost:13000
