# Merchant app environment — copy to `.env.local` and adjust per machine.
# `.env.local` is git-ignored; this example IS committed. Restart `pnpm dev`
# after changing env (Next reads it at startup).

# Backend origin the Next `/api/*` rewrite forwards to. The browser never
# sees this — calls stay same-origin (`/api/...`), so there is no CORS.
#
# Reach the backend locally via the SSH tunnel (see ../../SSH-README.md):
#   ./SSH-README.md --host <ip> --user <user> --identity <key> \
#       --remote-port 3000 --local-port 13000 --bg
#
# Then point this at the tunnel's local port. If you tunnel with
# `--local-port 3000`, you can omit this entirely (default is :3000).
API_PROXY_TARGET=http://localhost:13000
