# =============================================================================
# merchant-app/Dockerfile
# Multi-stage: pnpm monorepo builder → Next.js standalone → node:alpine runner
#
# Build context: repo root (crypto-payment-fe/)
#   docker build -f apps/merchant-app/Dockerfile .
#
# Build args (NEXT_PUBLIC_* are baked into the bundle at build time):
#   NEXT_PUBLIC_API_URL   Payment backend public URL  (default: http://localhost:3000)
#
# Runtime env vars (passed via env_file / -e at container start):
#   PORT               Server port (default: 5001)
#   HOSTNAME           Bind address  (default: 0.0.0.0)
# =============================================================================

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps

# Pin pnpm to match packageManager field in package.json (pnpm 11 requires Node >=22.13)
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

WORKDIR /app

# Workspace manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/                    ./packages/
COPY apps/merchant-app/package.json ./apps/merchant-app/

RUN pnpm install --frozen-lockfile

# ── Stage 2: builder ──────────────────────────────────────────────────────────
FROM deps AS builder

ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Disable Next.js telemetry in CI/build environments
ENV NEXT_TELEMETRY_DISABLED=1

COPY apps/merchant-app/ ./apps/merchant-app/

# Build — produces apps/merchant-app/.next/standalone/
RUN pnpm --filter merchant-app build

# ── Stage 3: runner ───────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

# Security: non-root user
RUN addgroup -g 1001 -S nodejs \
 && adduser  -u 1001 -S nextjs -G nodejs

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=5001
ENV HOSTNAME=0.0.0.0

# Standalone output includes a minimal server.js + required node_modules.
# In a pnpm monorepo the standalone mirrors the monorepo path structure,
# so server.js lives at apps/merchant-app/server.js inside standalone/.
COPY --from=builder --chown=nextjs:nodejs \
  /app/apps/merchant-app/.next/standalone ./

# Static assets and public folder must be copied separately (not in standalone)
COPY --from=builder --chown=nextjs:nodejs \
  /app/apps/merchant-app/.next/static \
  ./apps/merchant-app/.next/static

# Note: no public/ folder in merchant-app — add this COPY back if one is created later

USER nextjs

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:5001/ || exit 1

# server.js is the standalone entry point generated by Next.js
CMD ["node", "apps/merchant-app/server.js"]
